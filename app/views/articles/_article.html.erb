<div id="<%= dom_id article %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= article.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= article.name %>
  </div>
  <strong class="block font-medium mb-1">Tags:</strong>
  <%= article.tags.each do |tag| %>
    <%= link_to tag, style: "text-decoration:none" do %>
    <span class="tag"><%= link_to tag.name.capitalize %></span>
    <% end %>
  <% end %>
  <div>
    <strong class="block font-medium mb-1">Publish:</strong>
    <%= article.publish %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Body:</strong>
    <%= article.body %>
  </div>
</div>
