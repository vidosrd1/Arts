<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Posts" %>
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Posts</h1>
    <%= link_to "New post", new_post_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="posts" class="min-w-full 1divide-y 1divide-gray-200 1space-y-5">
    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <div class="row mt-4 clearfix">
          <h6 style="margin-top:0.1em; margin-bottom:1em"
          class="dark:text-slate-400 font-bold text-1xl mt-0 mb-1">
            <a href="/posts/<%= post.id %>",
            class="nav-link"><%= post.title %></a>
          </h6>
          <div class="col-4 col-sm-4 col-md-3 col-lg-3 clearfix">
            <% if post.image.attached? %>
            <a href="/posts/<%= post.id %>",
              style="width:12em; heigh:auto" class="nav-link">
              <%= image_tag(post.image) %>
            </a>
            <% end %>
          </div>
          <div style="margin-top:1em; margin-bottom:2em"
          class="col-8 col-sm-8 col-md-9 col-lg-9">
            <a href="/posts/<%= post.id %>",
            class="text-1 text-orange-500 nav-link"><%= post.name %></a>
            <%= truncate(strip_tags(post.body.to_s),
            length:400) %>
          </div>
          <br>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No posts found.</p>
    <% end %>
  </div>
</div>
