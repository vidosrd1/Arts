<% art.lists.order('created_at DESC').each do |list| %>
  <li style="margin-left:1.2em;
  margin-righr:0.6em"
  class="vertical-menu">
    <a href="/lists/<%= list.id %>",
    style="margin-left:0.6em;
    margin-righr:0.6em",
    class="nav-link">
    <%= truncate(strip_tags(list.title.to_s),
    length:50) %></a>
  </li>
<% end %>
<% content_for :title, "Arts" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Arts</h1>
    <%= link_to "New art", new_art_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>
  <div id="arts" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @arts.any? %>
      <% @arts.each do |art| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render art %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", art, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= link_to "Edit", edit_art_path(art), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= button_to "Destroy", art, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No arts found.</p>
    <% end %>
  </div>
</div>
